{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hom3bru/skill-belt/tree/codex/skill-belt/skills/jobscura/context/user-context.schema.json",
  "title": "Jobscura private user context v1-v2",
  "description": "Private source context and preferences. Contains no action grants or credentials. Version 2 adds optional monitoring and search preferences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "preferences"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "career_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "current_direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gap_scale",
            "main_max_gap"
          ],
          "properties": {
            "gap_scale": {
              "type": "integer",
              "const": 5
            },
            "main_max_gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "writing_guidance": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "monitoring": {
          "description": "Version 2. Workflow conventions for tracking cadence and reminders; never a permission.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dated_check_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "undated_check_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "reminder_windows_days": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 365
              }
            },
            "closing_horizon_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "shortlist_size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "urgency_open_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "long_open_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 730
            },
            "delivery_note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "search": {
          "description": "Version 2. What the user is looking for; a filter for discovery, not a hard rule unless the user says so.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_roles": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "locations": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "work_arrangements": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string",
                "enum": [
                  "onsite",
                  "hybrid",
                  "remote"
                ]
              }
            },
            "min_base_pay": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "currency",
                "period"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "period": {
                  "type": "string",
                  "enum": [
                    "year",
                    "month",
                    "week",
                    "day",
                    "hour"
                  ]
                }
              }
            },
            "exclusions": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "work_authorization_note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "materials": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "career_evidence",
              "resume",
              "writing_example",
              "submitted_application",
              "correction",
              "interview_notes"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "source_reference"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "source_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "observed_on": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  }
}
