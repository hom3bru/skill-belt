# diff-osd-2b9
diff --git a/phone.py b/phone.py
--- a/phone.py
+++ b/phone.py
@@ -5,4 +5,6 @@
 def format_phone(number):
     """'07700900123' -> '07700 900123'; spaces and dashes in the input are ignored."""
-    digits = str(int("".join(ch for ch in str(number) if ch.isdigit())))
-    return digits[:4] + " " + digits[4:]
+    digits = "".join(ch for ch in str(number) if ch.isdigit())
+    if len(digits) != 11:
+        raise ValueError("a UK number has 11 digits: %r" % number)
+    return digits[:5] + " " + digits[5:]
