diff --git a/app/export.py b/app/export.py
--- a/app/export.py
+++ b/app/export.py
@@ -4,10 +4,14 @@
 import io
 
 
-def export_rows(rows):
-    """CSV text for `rows`."""
+def export_rows(rows, seen=set()):
+    """CSV text for `rows`, skipping a row already written (so a retried export does not repeat lines)."""
     out = io.StringIO()
     writer = csv.writer(out)
     for row in rows:
+        key = tuple(row)
+        if key in seen:
+            continue
+        seen.add(key)
         writer.writerow(row)
     return out.getvalue()
