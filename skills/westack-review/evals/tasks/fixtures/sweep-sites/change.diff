diff --git a/app/tags.py b/app/tags.py
new file mode 100644
--- /dev/null
+++ b/app/tags.py
@@ -0,0 +1,9 @@
+# swp-tags-2r6
+"""Tag helpers for the tag picker."""
+
+
+def add_tag(tag, tags=[]):
+    """Return `tags` with `tag` added once, keeping order."""
+    if tag not in tags:
+        tags.append(tag)
+    return tags
