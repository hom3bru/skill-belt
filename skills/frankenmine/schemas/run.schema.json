        "shared_versions": {
          "type": "string",
          "minLength": 1
        },
        "resource_budget": {
          "type": "string",
          "minLength": 1
        },
        "higher_order": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cycles",
        "shared_versions",
        "resource_budget",
        "higher_order"
