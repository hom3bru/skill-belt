          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "test": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "components",
          "status",
          "rationale"
