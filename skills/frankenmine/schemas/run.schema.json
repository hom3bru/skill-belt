        "required": [
          "kind",
          "name",
          "evidence",
          "tradeoffs"
        ],
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "choice": {
          "type": "string",
          "enum": [
            "best-existing",
            "minimal-fresh",
            "fusion",
            "defer"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "choice",
        "rationale"
      ],
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "independent": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "changes-requested",
            "not-run"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adjudication": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "independence": {
          "type": "string",
          "enum": [
            "self",
            "fresh-context-same-model",
            "different-model",
            "human"
          ]
        },
        "report": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "reviewer",
        "disposition",
        "findings",
        "adjudication"
      ],
      "additionalProperties": false
