{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenmine.local/schema/run-1.1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "design",
        "implementation"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "brief": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "users": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "criterion"
            ],
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_language": {
          "type": "string",
          "minLength": 1
        },
        "write_scope": {
          "type": "string",
          "minLength": 1
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "enum": [
            "product-led",
            "exploratory"
          ]
        }
      },
      "required": [
        "outcome",
        "users",
        "non_goals",
        "requirements",
        "constraints",
        "target_language",
        "write_scope",
        "authorization"
      ],
      "additionalProperties": false
    },
    "donors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/donor"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "discoveries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/discovery"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "owner",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "compatible",
              "resolved",
              "conflict",
              "unknown",
              "independent"
