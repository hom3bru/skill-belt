    "supporting_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supporting_evidence"
      }
    },
    "requirement_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "discovery_searches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
