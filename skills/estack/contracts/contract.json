{
  "schema_version": 1,
  "vocabulary": "estack-shape-v1 (limited JSON Schema vocabulary; not a general validator)",
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "text",
        "origin",
        "status",
        "supersedes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "user",
            "repository",
            "assumption"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "parked"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "work_unit": {
      "type": "object",
      "required": [
        "id",
        "goal",
        "depends_on",
        "allowed_paths",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "done",
            "blocked"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "required",
        "requires_runtime",
        "requires_negative_control",
        "evidence_ids",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "requires_runtime": {
          "type": "boolean"
        },
        "requires_negative_control": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-run"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "target",
        "target_hash",
        "scope_id",
        "occurrence",
        "decision",
        "outcome",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "local-write",
            "install",
            "credential-access",
            "egress",
            "commit",
            "push",
            "pr",
            "merge",
            "deploy",
            "policy-edit"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "target_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "denied",
            "stale"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "not-applied",
            "applied",
            "uncertain",
            "denied"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "claim_id",
        "type",
        "revision",
        "patch_id",
        "scope_id",
        "artifact",
        "artifact_sha256",
        "operation",
        "environment",
        "raw_output",
        "raw_sha256",
        "recorded_at",
        "status",
        "collected",
        "executed",
        "passed",
        "failed",
        "skipped",
        "exit_code",
        "expected_exit",
        "negative_control",
        "coverage",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "source",
            "unit",
            "contract",
            "integration",
            "e2e",
            "host"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "raw_output": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "raw_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-run",
            "stale"
          ]
        },
        "collected": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expected_exit": {
          "type": "integer"
        },
        "negative_control": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "location",
        "consequence",
        "evidence_ids",
        "severity",
        "severity_rationale",
        "correction",
        "adjudication",
        "rationale",
        "verification_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "severity_rationale": {
          "type": "string",
          "minLength": 1
        },
        "correction": {
          "type": "string",
          "minLength": 1
        },
        "adjudication": {
          "type": "string",
          "enum": [
            "open",
            "accepted",
            "rejected",
            "fixed",
            "deferred"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "verification_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "author_id",
        "reviewer_id",
        "context_id",
        "patch_id",
        "kind",
        "status",
        "evidence_ids",
        "finding_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "self",
            "independent"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "not-run"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "source",
        "scope_id",
        "revision",
        "expires_at",
        "text",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "revalidated",
            "stale"
          ]
        }
      }
    },
    "doc": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target_version",
        "observed_version",
        "retrieved_at",
        "revalidate_after",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "revalidate_after": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "mismatch"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "scope_id",
        "patch_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "name",
        "availability",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "mode",
        "size",
        "goal",
        "non_goals",
        "scope_id",
        "revision",
        "patch_id",
        "author_id",
        "authority",
        "host",
        "requirements",
        "work_units",
        "acceptance",
        "actions",
        "evidence",
        "findings",
        "reviews",
        "lessons",
        "docs",
        "history",
        "state",
        "completion",
        "verification",
        "independent_review_required",
        "delivery",
        "next_safe_action",
        "blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "question",
            "investigate",
            "design",
            "build",
            "repair",
            "review",
            "finish"
          ]
        },
        "size": {
          "type": "string",
          "enum": [
            "tiny",
            "bounded",
            "cross-cutting"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "object",
          "required": [
            "allowed_actions",
            "forbidden_actions",
            "allowed_paths"
          ],
          "additionalProperties": false,
          "properties": {
            "allowed_actions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden_actions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowed_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "host": {
          "type": "object",
          "required": [
            "name",
            "version",
            "capabilities"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/capability"
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "work_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/work_unit"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "framed",
            "inspected",
            "planned",
            "authorized-work",
            "implemented",
            "verified",
            "delivered",
            "blocked",
            "needs-decision",
            "partial"
          ]
        },
        "completion": {
          "type": "string",
          "enum": [
            "open",
            "partial",
            "complete",
            "blocked"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "unverified",
            "source-audited",
            "runtime-tested"
          ]
        },
        "independent_review_required": {
          "type": "boolean"
        },
        "delivery": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "committed",
            "pushed",
            "pr",
            "merged",
            "deployed"
          ]
        },
        "next_safe_action": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "root": {
    "$ref": "#/$defs/task"
  },
  "transitions": {
    "framed": [
      "inspected",
      "blocked",
      "needs-decision"
    ],
    "inspected": [
      "planned",
      "authorized-work",
      "delivered",
      "blocked",
      "needs-decision"
    ],
    "planned": [
      "authorized-work",
      "delivered",
      "blocked",
      "needs-decision"
    ],
    "authorized-work": [
      "implemented",
      "blocked",
      "partial"
    ],
    "implemented": [
      "verified",
      "blocked",
      "partial"
    ],
    "verified": [
      "delivered",
      "implemented",
      "partial"
    ],
    "delivered": [
      "inspected"
    ],
    "blocked": [
      "inspected",
      "needs-decision",
      "partial"
    ],
    "needs-decision": [
      "inspected",
      "blocked"
    ],
    "partial": [
      "inspected",
      "blocked",
      "delivered"
    ]
  }
}
