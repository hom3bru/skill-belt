+def send_email(host, sender, to, body, retries=3):
+    for attempt in range(retries):
+        try:
+            with smtplib.SMTP(host) as server:
+                server.sendmail(sender, to, body)
+            return True
+        except smtplib.SMTPException:
+            time.sleep(attempt)
+    return False
 
 
