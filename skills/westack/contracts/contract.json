{
  "schema_version": 1,
  "vocabulary": "estack-shape-v1 (limited JSON Schema vocabulary; not a general validator)",
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "text",
        "origin",
        "status",
        "supersedes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "user",
            "repository",
            "assumption"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "parked"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "work_unit": {
      "type": "object",
      "required": [
        "id",
        "goal",
        "depends_on",
        "allowed_paths",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "done",
            "blocked"
          ]
        },
        "acceptance_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "retry_of": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "object",
          "required": [
            "owner",
            "state",
            "expires_at"
          ],
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "claimed",
                "lapsed",
                "inspected"
              ]
            },
            "expires_at": {
              "type": "string",
              "minLength": 1
            },
            "inspection": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "required",
        "requires_runtime",
        "requires_negative_control",
        "evidence_ids",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "requires_runtime": {
          "type": "boolean"
        },
        "requires_negative_control": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-run",
            "inconclusive"
          ]
        },
        "verifier": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "target",
        "target_hash",
        "scope_id",
        "occurrence",
        "decision",
        "outcome",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "local-write",
            "install",
            "credential-access",
            "egress",
            "commit",
            "push",
            "pr",
            "merge",
            "deploy",
            "policy-edit"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "target_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "denied",
            "stale"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "not-applied",
            "applied",
            "uncertain",
            "denied"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shown": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "answered_by": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "enum": [
            "cancelled",
            "failed",
            "truncated",
            "refused",
            "abandoned"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "claim_id",
        "type",
        "revision",
        "patch_id",
        "scope_id",
        "artifact",
        "artifact_sha256",
        "operation",
        "environment",
        "raw_output",
        "raw_sha256",
        "recorded_at",
        "status",
        "collected",
        "executed",
        "passed",
        "failed",
        "skipped",
        "exit_code",
        "expected_exit",
        "negative_control",
        "coverage",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "source",
            "review",
            "unit",
            "contract",
            "integration",
            "e2e",
            "host"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "raw_output": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "raw_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-run",
            "stale",
            "inconclusive"
          ]
        },
        "collected": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expected_exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "negative_control": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "object",
          "required": [
            "code"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "missing-prerequisite",
                "denied",
                "timeout",
                "crash",
                "unparseable",
                "no-oracle",
                "flaky",
                "cap-reached"
              ]
            },
            "observed": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "definition": {
          "type": "object",
          "required": [
            "sha256",
            "tool_version",
            "paths"
          ],
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            },
            "tool_version": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "producer": {
          "type": "object",
          "required": [
            "tool",
            "context_id"
          ],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "context_id": {
              "type": "string",
              "minLength": 1
            },
            "requested_model": {
              "type": "string",
              "minLength": 1
            },
            "observed_model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "location",
        "consequence",
        "evidence_ids",
        "severity",
        "severity_rationale",
        "correction",
        "adjudication",
        "rationale",
        "verification_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "severity_rationale": {
          "type": "string",
          "minLength": 1
        },
        "correction": {
          "type": "string",
          "minLength": 1
        },
        "adjudication": {
          "type": "string",
          "enum": [
            "open",
            "accepted",
            "rejected",
            "fixed",
            "deferred"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "verification_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "introduced": {
          "type": "string",
          "enum": [
            "patch",
            "affected-elsewhere",
            "pre-existing",
            "unknown"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "waived_patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "author_id",
        "reviewer_id",
        "context_id",
        "patch_id",
        "kind",
        "status",
        "evidence_ids",
        "finding_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "self",
            "independent"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "not-run"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "level": {
          "type": "string",
          "enum": [
            "self",
            "fresh-context-same-model",
            "different-model",
            "human"
          ]
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "source",
        "scope_id",
        "revision",
        "expires_at",
        "text",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "revalidated",
            "stale"
          ]
        }
      }
    },
    "doc": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target_version",
        "observed_version",
        "retrieved_at",
        "revalidate_after",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "revalidate_after": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "mismatch"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "scope_id",
        "patch_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "local-write",
              "install",
              "credential-access",
              "egress",
              "commit",
              "push",
              "pr",
              "merge",
              "deploy",
              "policy-edit"
            ]
          }
        },
        "resolves": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "required": [
        "paths",
        "exclude"
      ],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "name",
        "availability",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "ruled-out",
            "confirmed",
            "surprise",
            "follow-up",
            "memory-read"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "delegate": {
      "type": "object",
      "required": [
        "id",
        "parent",
        "executor",
        "tier",
        "scope",
        "status",
        "continuable"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "small",
            "mid",
            "top"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "finished",
            "budget-exhausted",
            "crashed",
            "lost",
            "declined",
            "cancelled",
            "waiting-on-person"
          ]
        },
        "continuable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "object",
          "required": [
            "disposition"
          ],
          "additionalProperties": false,
          "properties": {
            "disposition": {
              "type": "string",
              "enum": [
                "landed",
                "discarded"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "start_by": {
          "type": "string",
          "minLength": 1
        },
        "deadline_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "waiting_on": {
      "type": "object",
      "required": [
        "what",
        "check",
        "next_step",
        "expires_at"
      ],
      "additionalProperties": false,
      "properties": {
        "what": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "object",
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "file-exists",
                "hash-matches",
                "verdict-posted",
                "person-confirms"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "next_step": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "question",
        "choice",
        "alternatives",
        "origin",
        "status",
